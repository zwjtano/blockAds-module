#!name=口袋壁纸去广告 - Surge
#!desc=移除悬浮广告，精简我的页面。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/ShoujiDesk_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1462738233
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ShoujiDesk.png
#!date=2026-09-15 23:26:38

[URL Rewrite]
request if ${url} ~= /^https:\/\/api\.tdz5\.com\/search\/hotword\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.tdz5\.com\/ring\/hot\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.tdz5\.com\/base\/init\?/i then script("https://kelee.one/Resource/JavaScript/ShoujiDesk/base_init.js") with tag="移除首页广告配置", requires_body=true

[MITM]
hostname = %APPEND% api.tdz5.com
