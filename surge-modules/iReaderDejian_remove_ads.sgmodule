#!name=得间小说去广告 - Surge
#!desc=移除开屏广告、章末广告，移除扉页广告提示、听书界面广告提示、搜索栏填充词。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/iReaderDejian_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1454487240
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/iReaderDejian.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, smad.ms.zhangyue.net, REJECT
DOMAIN, saad.ms.zhangyue.net, REJECT

[URL Rewrite]
response if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/powerup\/userGroup\?/i then response.json.delete(["body.sevenDaysAd", "body.shortPlayShow", "body.sdkShortPlayAB"])

request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/djad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zyapi\/bookstore\/ad\//i then reject_dict(200)

response if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/search\/index\?/i then response.json.delete("body.keywords")

request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/bookshelf\/index\?/i then reject_dict(200)

[MITM]
hostname = %APPEND% dj.palmestore.com
