#!name=Telegram重定向 - Surge
#!desc=适用于安装了多个不同Telegram客户端的用户，用于在指定客户端中打开Telegram短链。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/TelegramRedirect.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1127750481
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Telegram.png
#!date=2026-08-03 01:09:35

[Argument]
app=select, "tg", "sg", "turrit", "ime", "ng", "lingo", tag=客户端, desc=指定跳转的客户端

[URL Rewrite]
request if ${url} ~= /^https:\/\/t\.me\/.+/ as item then redirect(307, "${app}://resolve?domain=${item.0}")

[MITM]
hostname = %APPEND% t.me
