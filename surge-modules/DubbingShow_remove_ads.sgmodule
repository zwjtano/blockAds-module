#!name=配音秀去广告 - Surge
#!desc=移除开屏广告、弹窗、横幅、各类关注推荐。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/DubbingShow_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id746925035
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DubbingShow.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/Api\/live\/LiveList/i then response.json.delete("data.banners")

response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/api\/live\/FollowList/i then response.json.delete("obj.data")

response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Friend\/GetRecommendUsers/i then response.json.delete("obj.data")

response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/api\/Union\/HomeData/i then response.json.delete("obj.data")

[Script]
response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Film\/GetConfigValue/i then script("https://kelee.one/Resource/JavaScript/DubbingShow/DubbingShow_remove_ads.js") with tag="移除首页底部弹窗", requires_body=true

[MITM]
hostname = %APPEND% iosapi.peiyinxiu.com
