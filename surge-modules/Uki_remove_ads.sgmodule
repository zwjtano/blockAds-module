#!name=Uki去广告 - Surge
#!desc=移除开屏广告、应用内悬浮窗，各类横幅、信息流广告、搜索填充词、我的页面广告。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/Uki_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1298912284
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Uki.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/startInfo$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/indexBanner$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/getPopup/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/allPopUpConfig$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/advConf$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/user\/checkQTSheInsurance$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/lover\/productList/i then script("https://kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除匹配卡横幅", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/friends\/closeFriend\/home/i then script("https://kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除密友横幅", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v\d\/party\/config$/i then script("https://kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除娱乐页面横幅和悬浮窗配置", requires_body=true

response if ${url} ~= /^https:\/\/api\.chenlongtech\.cn\/v1\/post\/fetchSearchRecommend$/i then script("https://kelee.one/Resource/JavaScript/Uki/Uki_remove_ads.js") with tag="移除广场搜索填充词", requires_body=true

[MITM]
hostname = %APPEND% api.chenlongtech.cn
