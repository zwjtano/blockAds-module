#!name=中国移动云盘去广告 - Surge
#!desc=移除中国移动云盘开屏广告及应用内广告，首页的多余卡片可滑到最底部自定义隐藏掉，插件对此不做处理。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/mobileClouds_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1618137934
#!author=RuCu6[https://github.com/RuCu6]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/mobileClouds.png
#!date=2026-10-02 13:57:49

[Script]
response if ${url} ~= /^https:\/\/jzts\.cmpassport\.com\/personalized\/getPushContent/i then script("https://kelee.one/Resource/JavaScript/mobileClouds/mobileClouds_remove_ads.js") with tag="移除开屏广告", requires_body=true

response if ${url} ~= /^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\//i then script("https://kelee.one/Resource/JavaScript/mobileClouds/mobileClouds_remove_ads.js") with tag="移除应用内广告", requires_body=true

[MITM]
hostname = %APPEND% jzts.cmpassport.com, ad.mcloud.139.com
