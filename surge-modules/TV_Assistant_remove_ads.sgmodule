#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TV_Assistant.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/saas\.hpplay\.cn\/api\/lebo-desk\/endpoint\/app-resource\/app_home_pop_up/i then reject_dict(200)
request if ${url} ~= /^https:\/\/saas\.hpplay\.cn\/api\/lebo-desk\/endpoint\/app-resource\/app_home_tips/i then reject_dict(200)
request if ${url} ~= /^https:\/\/saas\.hpplay\.cn\/api\/lebo-desk\/endpoint\/app-resource\/app_index_operate2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/saas\.hpplay\.cn\/api\/lebo-rabbit\/app-card\/list/i then reject_dict(200)
request if ${url} ~= /^https:\/\/saas\.hpplay\.cn\/api\/lebo-desk\/endpoint\/app-resource\/app-user-banner/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/saas\.hpplay\.cn\/api\/lebo-desk\/endpoint\/app-resource\/app_tab_red_dot\?user-tag=1$/i then script("https://kelee.one/Resource/JavaScript/TV_Assistant/TV_Assistant_remove_ads.js") with tag="移除底栏视频标签", requires_body=true

[MITM]
hostname = %APPEND% saas.hpplay.cn
