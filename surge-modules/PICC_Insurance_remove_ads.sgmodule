#!name=中国人保去广告 - Surge
#!desc=移除中国人保开屏广告和应用内广告；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/PICC_Insurance_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id710189980
#!author=Sliverkiss[https://github.com/Sliverkiss]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PICC_Insurance.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/h\/headlines\/queryHeadlines/i then reject(404)
request if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/update\/startupPage\/v1/i then reject_dict(200)
request if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/guessYouLike\/v3/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/a\/config\/homeInit\/v3/i then script("https://kelee.one/Resource/JavaScript/PICC_Insurance/PICC_Insurance_remove_ads.js") with tag="移除主页推广", requires_body=true

response if ${url} ~= /^https:\/\/zgrb\.epicc\.com\.cn\/G-HAPP\/mpageconfig\/myPageConfigList\/v3/i then script("https://kelee.one/Resource/JavaScript/PICC_Insurance/PICC_Insurance_remove_ads.js") with tag="移除我的页面推广", requires_body=true

[MITM]
hostname = %APPEND% zgrb.epicc.com.cn
