#!name=IPA工具箱助手 - Surge
#!desc=这是IPA工具箱的辅助插件，用于下载IPA包和应用降级。IPA工具箱是运行在Scripting应用中的脚本，需要购买Scripting的Pro版本才能运行。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/IPATool.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id6479691128
#!author=小白脸
#!tag=功能增强
#!system=
#!system_version=18
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/IPATool.png
#!date=2026-10-02 13:57:49

[Script]
request if ${url} ~= /^https:\/\/apple-api\.com/i then script("https://kelee.one/Resource/JavaScript/IPATool/AppStoreAPI.js") with tag="App Store API", requires_body=true

request if ${url} ~= /^https:\/\/xiaobai\.app/i then script("https://kelee.one/Resource/JavaScript/IPATool/Installer.js") with tag="安装器"

[MITM]
hostname = %APPEND% apple-api.com, xiaobai.app
