#!name=风鸟去广告 - Surge
#!desc=移除首页信息流和轮播图；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/RiskBird_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1528682937
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/RiskBird.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList/i then reject_dict(200)

request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend/i then script("https://kelee.one/Resource/JavaScript/RiskBird/RiskBird_remove_ads.js") with tag="移除推荐老板", requires_body=true

[MITM]
hostname = %APPEND% m.riskbird.com
