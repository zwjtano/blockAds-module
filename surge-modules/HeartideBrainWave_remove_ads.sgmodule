[URL Rewrite]
request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/startup\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/user\/identity\/ad\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/discover\/ad$/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/home\/activity\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/newborn\/ad\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/my\/ad\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/search\/config\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/newborn\/search\/ranks\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/search\/inputs\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/newborn\/sleeps\/guides\/banner\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/api\.psy-1\.com\/cosleep\/newborn\/search\/ranks\/items\?/i then reject_dict(200)

[MITM]
hostname = %APPEND% api.psy-1.com
