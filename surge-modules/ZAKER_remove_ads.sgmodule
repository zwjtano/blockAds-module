#!name=ZAKER去广告 - Surge
#!desc=移除开屏广告、置顶轮播图广告和文末广告。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/ZAKER_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id462149227
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZAKER.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/iphone\.myzaker\.com\/zaker\/cover\.php\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/iphone\.myzaker\.com\/zaker\/article_mongo_sec\.php\?/i then response.json.delete("data.ad_url")
response if ${url} ~= /^https:\/\/ggs\.myzaker\.com\/zk_article_ad\.php\?/i then response.json.delete(["data.article_bottom", "data.recommend_ad"])

response if ${url} ~= /^https:\/\/iphone\.myzaker\.com\/zaker\/follow_promote\.php\?/i then response.json.jq(".data.list |= map(select(.type != \"web\"))")

response if ${url} ~= /^https:\/\/iphone\.myzaker\.com\/zaker\/car_tab\/index\.php\?/i then response.json.jq(".data.gallery |= map(select(.type != \"web\"))")

request if ${url} ~= /^https:\/\/iphone\.myzaker\.com\/zaker\/block_top_ad\.php\?/i then reject_dict(200)

[MITM]
hostname = %APPEND% iphone.myzaker.com, ggs.myzaker.com
