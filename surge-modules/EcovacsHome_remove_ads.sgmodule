#!name=ECOVACS HOME去广告 - Surge
#!desc=移除横幅推广，精简底栏。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/EcovacsHome_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1329458504
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/EcovacsHome.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
response if ${url} ~= /^https:\/\/gl-cn-api\.ecovacs\.cn\/v3\/private\//i then response.json.jq(".data.navigateInfoResponseList |= map(select(.positionType == \"Robot\" or .positionType == \"Mine\"))")

request if ${url} ~= /^https:\/\/api-app\.dc-cn\.cn\.ecouser\.net\/api\/ecms\/app\/ad\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/gl-cn-api\.ecovacs\.cn\/v1\/private\//i then reject_dict(200)

[MITM]
hostname = %APPEND% gl-cn-api.ecovacs.cn, api-app.dc-cn.cn.ecouser.net
