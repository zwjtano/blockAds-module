#!name=皮皮虾去广告 - Surge
#!desc=移除开屏广告、评论区广告、视频流广告，精简我的页面。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/PiPiXia_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1393912676
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PiPiXia.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/api(5-lq)?\.pipix\.com\/api\/ad\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/api(5-lq)?\.pipix\.com\/bds\/banner\//i then reject_dict(200)

request if ${url} ~= /^https:\/\/api(5-lq)?\.pipix\.com\/bds\/feed\/follow_feed\//i then reject_dict(200)

response if ${url} ~= /^https:\/\/api(5-lq)?\.pipix\.com\/bds\/feed\/stream\/v2\//i then response.json.jq(".data.data |= map(select(has(\"ad_info\") | not))")

response if ${url} ~= /^https:\/\/api(5-lq)?\.pipix\.com\/bds\/user\/check_in\//i then response.json.jq(".data.profile_entrances |= map(select(.title != \"放心借\" and .title != \"洋钱罐借款\")) | del(.data.pet_interface_message)")

[MITM]
hostname = %APPEND% api.pipix.com, api5-lq.pipix.com
