#!name=天气通去广告 - Surge
#!desc=移除开屏广告、横幅广告、弹窗广告，精简底栏及我的页面。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/TianQiTong_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id458032309
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/TianQiTong.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/forecast\.sina\.cn\/app\/overall\/switch\.php\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/tqt\.weibo\.cn\/business\/advert\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/tqt\.weibo\.cn\/user\/device\/ad_multi_star\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/tqt\.weibo\.cn\/operation\/activity\//i then reject_dict(200)

response if ${url} ~= /^https:\/\/tqt\.weibo\.cn\/master\/nav\/tab\?/i then response.json.jq("map(.tabs|=map(select(.type==\"weather\" or .type==\"radar\" or .type==\"my\")))")

request if ${url} ~= /^https:\/\/tqt\.weibo\.cn\/api\/user\/user\/\d\.\d\/\?method=personal_center$/i then reject_dict(200)

[MITM]
hostname = %APPEND% forecast.sina.cn, tqt.weibo.cn
