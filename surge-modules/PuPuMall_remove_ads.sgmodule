#!name=朴朴超市去广告 - Surge
#!desc=移除超市去开屏广告，移除首页顶部轮播图和图标广告、启动小弹图广告、首页右下角悬浮动画、搜索热搜榜、搜索建议词、搜索发现热词、订单页面商，精简我的页面。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/PuPuMall_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1144025167
#!author=kelv1n1n[https://github.com/kelv1n1n], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PuPuMall.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/account\/discount\/order/i then reject(404)
request if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100/i then reject(404)

[Script]
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7/i then script("https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/search_component_banner/i then script("https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/search\/hot_keywords\/v3/i then script("https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/app_resource\/resource_preload\/list_h5_resource/i then script("https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/recommendation\/interests\/products/i then script("https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true
response if ${url} ~= /^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1/i then script("https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js") with tag="移除朴朴超市广告", requires_body=true

[MITM]
hostname = %APPEND% j1.pupuapi.com
