#!name=微信公众号去广告 - Surge
#!desc=过滤微信公众号广告；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/Weixin_Official_Accounts_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id414478124
#!author=RuCu6[https://github.com/RuCu6]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weixin.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN-SUFFIX, wxs.qq.com, REJECT

[URL Rewrite]
request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/(cps_product_info|getappmsgad|jsmonitor|masonryfeed|relatedarticle)\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword/i then reject_dict(200)


[MITM]
hostname = %APPEND% mp.weixin.qq.com
