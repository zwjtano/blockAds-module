#!name=百度翻译去广告 - Surge
#!desc=移除开屏广告、横幅广告，精简我的页面。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/BaiduTranslate_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id605670941
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduTranslate.png
#!date=2026-10-02 13:57:49

[URL Rewrite]
request if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/transapp\/v2\/api\/launch\/config\?/i then reject_dict(200)

response if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/transapp\/comment\/my\?/i then response.json.delete(["data.taskBanner", "data.act"])

response if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/transapp\/recitewd\/myplan\?/i then response.json.delete(["data.activityRec", "data.activityRecList"])

request if ${url} ~= /^https:\/\/fanyi-app\.baidu\.com\/static\/react-activity\/page\/courseBoutique\.html\?/i then reject(404)

[MITM]
hostname = %APPEND% fanyi-app.baidu.com
