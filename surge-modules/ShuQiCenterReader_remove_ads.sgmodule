#!name=书旗小说去广告 - Surge
#!desc=移除书城横幅广告、听书广告、阅读广告、章末推荐、福利入口、悬浮窗、推荐搜索词，精简我的页面。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/ShuQiCenterReader_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id733689509
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ShuQiCenterReader.png
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, render-web.11222.cn, REJECT

[URL Rewrite]
request if ${url} ~= /^https:\/\/huichuan\.sm\.cn\/nativead/i then reject_dict(200)

request if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/api\/route\/iosReadPage\/adV2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/api\/route\/ios\/readPage$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/api\/render\/load\/resource/i then reject(404)

[Script]
response if ${url} ~= /^https:\/\/ocean\.shuqireader\.com\/sqios\/render\/render\/page\/bookstore$/i then script("https://kelee.one/Resource/JavaScript/ShuQiCenterReader/ShuQiCenterReader_remove_ads.js") with tag="移除书城横幅和阅读广告", requires_body=true

[MITM]
hostname = %APPEND% ocean.shuqireader.com, huichuan.sm.cn
