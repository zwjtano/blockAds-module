#!name=5EPlay去广告 - Surge
#!desc=移除开屏广告、弹窗广告、活动角标、商城。；由 Loon 插件自动转换为 Surge 模块，建议导入前抽查。
#!homepage=https://kelee.one/Tool/Loon/Lpx/5EPlay_remove_ads.lpx
#!system=ios
#!openUrl=https://apps.apple.com/app/id1149334962
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!tag=去广告
#!system=
#!system_version=
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/5EPlay.png
#!date=2026-08-24 18:59:19

[URL Rewrite]
^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? response-body-json-del data.function_configs.startup_ad_switch data.function_configs.startup_ad_timeout data.function_configs.startup_ad_day_max data.function_configs.app_bar_guide_width data.function_configs.app_bar_guide_height data.function_configs.app_bar_guide_url data.function_configs.app_bar_guide_time data.function_configs.home_tab_event_tag data.function_configs.home_tab_event_tag_ext data.function_configs.home_tab_player_tag data.function_configs.home_tab_player_tag_ext data.function_configs.task_center_entrance data.function_configs.store_go data.function_configs.wall_closed

^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$ response-body-json-del data.float_advertise

^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ reject-dict

^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$ response-body-json-del data.placeholder

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com
